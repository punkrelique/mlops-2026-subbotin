# Окружение
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Данные и модели — в DVC, не в Git
# (DVC сам добавляет записи в .gitignore рядом с файлами при `dvc add`,
# поэтому сами папки здесь не игнорируем, иначе .dvc-файлы тоже будут git-ignored)

# Метрики и отчёты — маленькие, их держим в Git:
# так работают `dvc metrics diff` и сравнение между коммитами
/reports/*
!/reports/.gitkeep
!/reports/*.json
!/reports/*.md

# MLflow локальный бэкенд
mlruns/
mlartifacts/
mlflow.db

# Секреты
.env
*.pem
*.key

